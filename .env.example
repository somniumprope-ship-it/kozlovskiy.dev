# Пароль входа в /admin (обязателен в production)
ADMIN_PASSWORD=change-me
# Порт сервера
PORT=3001
# Где хранить контент, загрузки и подписчиков (по умолчанию ./data)
# DATA_DIR=/var/lib/kozlovskiy
# Лимит одного загружаемого файла, МБ
# MAX_UPLOAD_MB=200
# Необязательно: секрет подписи сессий (иначе создаётся сам и хранится в DATA_DIR/.secret)
# SESSION_SECRET=
